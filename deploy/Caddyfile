# Em produção, troque o bloco ":80" abaixo por um domínio real, ex.:
#   crm.suaempresa.com {
#       ...
#   }
# para que o Caddy emita e renove TLS automático via Let's Encrypt (HTTPS real).
# Nesse momento, também defina DJANGO_HTTPS=true no ambiente do serviço backend
# para habilitar SECURE_SSL_REDIRECT, cookies seguros e HSTS no Django.
:80 {
    handle /static/* {
        root * /srv
        file_server
    }
    # /media/ é servido na mesma origem do CRM: só sai mídia (imagem e áudio), sem o navegador "adivinhar"
    # o tipo e sem rodar script; comprovantes nunca saem por aqui (ficam fora do volume, ver HARDENING F1-01/F1-02).
    handle /media/* {
        route {
            respond /media/comprovantes/* 404
            @nao_midia not path_regexp (?i)\.(png|jpe?g|webp|ogg)$
            respond @nao_midia 404
            header X-Content-Type-Options nosniff
            header Content-Security-Policy "default-src 'none'; sandbox"
            root * /srv
            file_server
        }
    }
    @backend path /api/* /admin/* /ws/* /health/*
    handle @backend {
        # O TLS real (crm.axiomaia.com.br) é terminado antes de chegar aqui -- esse Caddy só
        # recebe HTTP puro na VPS. Sem isso, Django nunca sabe que a requisição original era
        # https (request.build_absolute_uri() gera link "http://" e dá mixed-content no navegador).
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto https
        }
    }
    handle {
        reverse_proxy frontend:80
    }
}
